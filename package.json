{
  "name": "cryptolab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Learn cryptography by watching real algorithms transform real input, step by step.",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite-react-ssg dev",
    "build": "tsc -b && vite-react-ssg build && node scripts/generate-sitemap.mjs && node scripts/verify-og.mjs",
    "preview": "vite preview --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "python3 -m unittest discover -s tests",
    "typecheck": "tsc -b --noEmit",
    "vectors": "node scripts/gen-vectors.mjs",
    "og": "node scripts/generate-og.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:python"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-react-ssg": "^0.9.2",
    "vitest": "^3.2.0",
    "wawoff2": "^2.0.1"
  }
}
